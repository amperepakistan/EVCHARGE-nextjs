{
  "name": "evcharge-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:supabase": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > types/database.types.ts",
    "scrape:apify": "node --env-file=.env.local scripts/scrape-apify.mjs",
    "scrape:normalize": "node --env-file=.env.local scripts/normalize-apify.mjs",
    "scrape:seed": "node --env-file=.env.local scripts/seed-terminals.mjs scripts/output/terminals-scraped-pk.json",
    "seed:users": "node --env-file=.env.local scripts/seed-demo-users.mjs",
    "seed:connected": "node --env-file=.env.local scripts/seed-connected-terminals.mjs",
    "seed:cameras": "node --env-file=.env.local scripts/seed-cameras.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@supabase/supabase-js": "^2.49.1",
    "apify-client": "^2.24.0",
    "bcryptjs": "^3.0.2",
    "firebase-admin": "^14.2.0",
    "internmap": "^2.0.3",
    "jose": "^6.0.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
