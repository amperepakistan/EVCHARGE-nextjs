# Server-only — never prefix these with NEXT_PUBLIC_
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=replace-with-a-long-random-string
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Public anon key is used by the Flutter driver app (RLS-gated SELECT on terminals).
SUPABASE_ANON_KEY=your-anon-key

# Apify Scraper Configuration
APIFY_TOKEN=your-apify-token
APIFY_MAPS_ACTOR=compass/crawler-google-places
APIFY_EV_ACTOR=dataquarry/ev-charging-stations

# Firebase Admin FCM Configuration (Server-Side Push Sending)
# Paste contents of service-account.json as a JSON string, OR provide path via FIREBASE_SERVICE_ACCOUNT_PATH
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"ampere-ac9f0",...}

